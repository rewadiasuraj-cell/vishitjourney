{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 0 */3 * *"
    }
  ],
  "rewrites": [
    { "source": "/chardham-itinerary", "destination": "/chardham_itinerary.html" },
    { "source": "/chardham_itinerary", "destination": "/chardham_itinerary.html" },
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/admin/login.php", "destination": "/admin.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/blog", "destination": "/blog.html" }
  ]
}
